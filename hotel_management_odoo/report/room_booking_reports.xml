<?xml version = "1.0" encoding = "UTF-8" ?>
<odoo>
    <!--    Room booking report action-->
    <record id="action_report_room_booking" model="ir.actions.report">
        <field name="name">Room Booking Order</field>
        <field name="model">room.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_room_booking</field>
        <field name="report_file">hotel_management_odoo.report_room_booking</field>
        <field name="binding_model_id" ref="model_room_booking"/>
        <field name="binding_type">report</field>
    </record>
    <!--    Room booking template-->
    <template id="report_room_booking">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Room Booking Order</h2>
                    <br/>
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Sl No.</th>
                                <th>Guest Name</th>
                                <th>Room No.</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>Reference No.</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="0"/>
                            <t t-if="docs">
                                <t t-foreach="docs" t-as="doc">
                                    <t t-set="i" t-value="i+1"/>
                                    <t t-set="state_dict" t-value="{'draft': 'Draft', 'reserved': 'Reserved', 'check_in': 'Check In', 'check_out': 'Check Out', 'cancel': 'Cancelled', 'done': 'Done'}"/>
                                    <tr>
                                        <td><t t-esc="i"/></td>
                                        <td><t t-esc="doc.partner_id.name if doc.partner_id else ''"/></td>
                                        <td><t t-esc="doc.room_number or ''"/></td>
                                        <td><t t-esc="doc.checkin_date or ''"/></td>
                                        <td><t t-esc="doc.checkout_date or ''"/></td>
                                        <td><t t-esc="doc.name or ''"/></td>
                                        <td><t t-esc="state_dict.get(doc.state, doc.state or '')"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-elif="booking">
                                <t t-foreach="booking" t-as="line">
                                    <t t-set="i" t-value="i+1"/>
                                    <tr>
                                        <td><t t-esc="i"/></td>
                                        <td><t t-esc="line['partner_id']"/></td>
                                        <td><t t-esc="line['room']"/></td>
                                        <td><t t-esc="line['checkin_date']"/></td>
                                        <td><t t-esc="line['checkout_date']"/></td>
                                        <td><t t-esc="line['name']"/></td>
                                        <td><t t-esc="line['state']"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
