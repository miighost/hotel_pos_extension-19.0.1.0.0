<?xml version = "1.0" encoding = "UTF-8" ?>
<odoo>
    <!--    Restro report action-->
    <record id="action_report_restro_report" model="ir.actions.report">
        <field name="name">Restro Report</field>
        <field name="model">food.booking.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_restro_report</field>
        <field name="report_file">hotel_management_odoo.report_restro_report</field>
        <field name="binding_model_id" ref="model_food_booking_line"/>
        <field name="binding_type">report</field>
    </record>
    <!--    Restro report template-->
    <template id="report_restro_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Restro Report</h2>
                    <br/>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sl No.</th>
                                <th>Name</th>
                                <th>Room No</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <t t-set="i" t-value="0"/>
                        <t t-foreach="booking" t-as="line">
                            <t t-set="i" t-value="i+1"/>
                            <tr>
                                <td>
                                    <t t-esc="i"/>
                                </td>
                                <td>
                                    <t t-esc="line['name']"/>
                                </td>
                                <td>
                                    <t t-esc="line['room']"/>
                                </td>
                                <td>
                                    <t t-esc="line['state']"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
